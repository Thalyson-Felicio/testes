@startuml
title 3.3 Teste Beta com grupo piloto
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Grupo piloto" as usuarios
component "VersaoBeta\n<<Componente sob teste>>" as beta
component "AplicacaoNavegacao" as app
component "ServicoPosicionamento" as servico
component "ReceptorGPS" as receptor
component "Telemetria" as telemetria
component "Feedback" as feedback

usuarios --> beta : usar em redes e aparelhos variados
beta --> app : acessar funcionalidades
app --> servico : solicitar posicao
servico --> receptor : coletar sinais reais do ambiente
receptor --> servico : observacoes e qualidade
servico --> app : posicao calculada
app --> telemetria : enviar metricas anonimizadas
usuarios --> feedback : relatar comportamento
telemetria --> beta : evidencias de uso
feedback --> beta : relatos do grupo piloto
@enduml
