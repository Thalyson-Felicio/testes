@startuml
title 4.2 Teste de seguranca — protecao da atualizacao orbital
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Operador sem permissao" as atacante
actor "Operador autorizado" as operador
component "EstacaoControleTerrestre\n<<Sistema Externo>>" as estacao
component "ControleAcessoAtualizacao\n<<Componente sob teste>>" as acesso
component "RepositorioDadosOrbitais\n<<Servico Real>>" as repo
component "AuditoriaSeguranca" as auditoria

atacante --> estacao : enviar efemerides adulteradas
estacao --> acesso : solicitarAtualizacao(credencial)
acesso --> auditoria : registrar tentativa
acesso --x repo : bloquear sem permissao
operador --> estacao : enviar efemerides assinadas
estacao --> acesso : solicitarAtualizacao(credencial valida)
acesso --> auditoria : registrar autorizacao
acesso --> repo : atualizar dados orbitais
@enduml
